# pyenv
#   For a library or app, you might want to share your .python-version.
#   Comment this out if so.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing pipenv in a non-standard way, or if you prefer to exclude it:
# lock/

# poetry
#   Poetry uses pyproject.toml to manage dependencies. lock file should be tracked.
#   But sometimes cache is local.
# .poetry/

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
.pdm-plugins/

