# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ── Cloudflare AI Fallback LLM ────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id
CLOUDFLARE_API_TOKEN=your_cf_api_token
CLOUDFLARE_MODEL=@cf/moonshotai/kimi-k2.6 

USE_CLOUDFLARE_FALLBACK=true

# ── Optional API keys ─────────────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_org_key_here
GNEWS_API_KEY=your_gnews_api_key_here
GITHUB_TOKEN=ghp_your_token_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/db_name 
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=                    # upstash Redis url -   cloud redis    
CACHE_QUERY_TTL=3600
CACHE_SEARCH_TTL=1800
CACHE_ANSWER_TTL=7200

# ── Gemini models ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=4096

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── RAG ───────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=perplexity_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=10
RAG_RETRIEVE_TOP_K=50
RAG_SCORE_THRESHOLD=0.35
MAX_HOPS=2 

# ── Reranking ─────────────────────────────────────────────────────────────────
ENABLE_RERANKING=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=10

# ── Hybrid Search ─────────────────────────────────────────────────────────────
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ── Pipeline ──────────────────────────────────────────────────────────────────
MAX_SUB_QUERIES=4
MAX_SEARCH_RESULTS=5
PIPELINE_TIMEOUT_S=120
RESEARCH_TIMEOUT_S=300
ENABLE_EVAL=true
EVAL_ONLY_RESEARCH=true

# ── ARQ Workers ───────────────────────────────────────────────────────────────
ARQ_MAX_JOBS=50
ARQ_JOB_TIMEOUT=120
WORKER_CONCURRENCY=4

# ── Observability ─────────────────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=perceptyxai-v2
LOG_LEVEL=INFO
ENABLE_OTEL=false
ENABLE_PROMETHEUS=true

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
# ── Tavily Search (LLM-optimised web search) ─────────────────────────────────
TAVILY_API_KEY=tvly-your_tavily_key_here

# ── Firecrawl (deep web scraping + search) ───────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_key_here
